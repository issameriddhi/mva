# load packages
library(lavaan)
library(semPlot)
library(dplyr)


data <- read.csv("E:/a_msc_SEM1/mva/archive (3)/apple_quality.csv")

 
data$A_id <- NULL

# convert Quality to Numeric 
data$Quality <- as.numeric(as.factor(data$Quality))


data$Acidity <- as.numeric(data$Acidity)


model <- '
# relationships
Sweetness ~ Size
Juiciness ~ Size + Crunchiness
Acidity ~ Size 
Quality ~ Size + Sweetness + Juiciness + Acidity

# covariance
Size ~~ Crunchiness
'

fit <- sem(model, data = data)

summary(fit, standardized = TRUE, fit.measures = TRUE)

# PLOT
semPaths(fit,
         what="std",
         layout="tree",
         style="ram",
         edge.label.cex=1.2,
         sizeMan=7,
         residuals=FALSE,
         intercepts=FALSE,
         nCharNodes=0,
         posCol="darkgreen",
         negCol="red",
         edge.width=2,
         weighted=TRUE,
         fade=FALSE,
         rotation=2)
